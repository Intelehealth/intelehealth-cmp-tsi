{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "_func"
  ],
  "properties": {
    "_func": {
      "type": "string"
    },
    "fiduciary_id": {
      "type": "string"
    },
    "key_id": {
      "type": "string"
    },
    "api_key": {
      "type": "string"
    }
  },
  "anyOf": [
    {
      "required": [
        "key_id"
      ]
    },
    {
      "required": [
        "api_key"
      ]
    }
  ]
}
