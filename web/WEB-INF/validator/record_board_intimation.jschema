{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Record the Data Protection Board intimation of a breach (Rule 7)",
  "type": "object",
  "properties": {
    "_func": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "board_reference": {
      "type": "string",
      "minLength": 1
    },
    "intimated_at": {
      "type": "string"
    },
    "fiduciary_id": {
      "type": "string"
    }
  },
  "required": [
    "_func",
    "id",
    "board_reference"
  ]
}
