{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Generated schema for Root",
  "type": "object",
  "properties": {
    "_func": {
      "type": "string"
    },
    "grievance_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "NEW",
        "IN_PROGRESS",
        "ESCALATED",
        "RESOLVED",
        "CLOSED"
      ]
    },
    "resolution_details": {
      "type": "string"
    }
  },
  "required": [
    "_func",
    "grievance_id",
    "status"
  ]
}
