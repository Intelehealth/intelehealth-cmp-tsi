{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Generated schema for Root",
  "type": "object",
  "properties": {
    "_func": {
      "type": "string"
    },
    "child_principal_id": {
      "type": "string"
    },
    "guardian_principal_id": {
      "type": "string"
    },
    "verification_mechanism": {
      "type": "string",
      "enum": [
        "EXISTING_ACCOUNT",
        "DIGILOCKER",
        "AADHAAR_VC",
        "KYC_PROVIDER",
        "OTP_LINKING"
      ]
    },
    "provider_name": {
      "type": "string"
    },
    "verification_ref_id": {
      "type": "string"
    },
    "proof_metadata": {
      "type": "object"
    },
    "fiduciary_id": {
      "type": "string"
    }
  },
  "required": [
    "_func",
    "child_principal_id",
    "guardian_principal_id",
    "verification_mechanism"
  ]
}
