{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Create Role",
  "type": "object",
  "properties": {
    "_func": { "type": "string" },
    "role_code": { "type": "string" },
    "code": { "type": "string" },
    "name": { "type": "string" },
    "description": { "type": "string" },
    "permissions": { "type": "array", "items": { "type": "string" } }
  },
  "required": ["_func", "name", "permissions"]
}