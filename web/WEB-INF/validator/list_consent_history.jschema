{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Generated schema for Root",
  "type": "object",
  "properties": {
    "_func": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "user_ref": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "fiduciary_id": {
      "type": "string"
    },
    "page": {
      "type": "number"
    },
    "limit": {
      "type": "number"
    },
    "purpose_id": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "start_date": {
      "type": "string"
    },
    "end_date": {
      "type": "string"
    }
  },
  "required": [
    "_func"
  ],
  "anyOf": [
    {
      "required": [
        "user_id"
      ]
    },
    {
      "required": [
        "user_ref"
      ]
    }
  ]
}
