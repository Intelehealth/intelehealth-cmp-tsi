{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Generated schema for Root",
  "type": "object",
  "properties": {
    "_func": {
      "type": "string"
    },
    "record_id": {
      "type": "string"
    },
    "policy_id": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "fiduciary_id": {
      "type": "string"
    }
  },
  "required": [
    "_func"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "policy_id": {
            "minLength": 1
          }
        },
        "required": [
          "policy_id"
        ]
      },
      "then": {
        "required": [
          "user_id"
        ]
      }
    }
  ]
}