{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Create Nomination",
  "type": "object",
  "properties": {
    "_func":                    { "type": "string" },
    "fiduciary_id":             { "type": "string" },
    "nominating_principal_id":  { "type": "string" },
    "nominated_principal_id":   { "type": "string" },
    "relationship":             { "type": "string" },
    "valid_from":               { "type": "string" },
    "valid_until":              { "type": "string" }
  },
  "required": ["_func", "nominating_principal_id", "nominated_principal_id"]
}
