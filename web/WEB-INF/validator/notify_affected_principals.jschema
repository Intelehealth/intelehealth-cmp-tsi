{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Notify the principals affected by a personal data breach (s.8(6))",
  "type": "object",
  "properties": {
    "_func": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "user_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "fiduciary_id": {
      "type": "string"
    }
  },
  "required": [
    "_func",
    "id"
  ]
}
