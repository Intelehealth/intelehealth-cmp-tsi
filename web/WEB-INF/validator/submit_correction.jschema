{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Submit Correction",
  "type": "object",
  "properties": {
    "_func":           { "type": "string" },
    "fiduciary_id":    { "type": "string" },
    "user_id":         { "type": "string" },
    "field_name":      { "type": "string" },
    "current_value":   { "type": "string" },
    "requested_value": { "type": "string" },
    "reason":          { "type": "string" }
  },
  "required": ["_func", "user_id", "field_name", "requested_value"]
}
