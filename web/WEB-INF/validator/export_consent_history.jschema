{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Export Consent History",
  "type": "object",
  "properties": {
    "_func": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "format": {
      "type": "string",
      "enum": [
        "csv",
        "pdf",
        "CSV",
        "PDF"
      ]
    },
    "language": {
      "type": "string",
      "description": "UD-04: policy language block used for purpose names in the PDF; defaults to the language of each record."
    }
  },
  "required": [
    "_func"
  ]
}
