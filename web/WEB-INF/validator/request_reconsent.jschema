{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Generated schema for Root",
  "type": "object",
  "properties": {
    "_func": { "type": "string" },
    "policy_id": { "type": "string" },
    "version": { "type": "string" },
    "policy_version": { "type": "string" },
    "user_id": { "type": "string" },
    "data_point_consents": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "data_point_id": { "type": "string" },
          "consent_granted": { "type": "boolean" }
        }
      }
    },
    "jurisdiction": { "type": "string" },
    "language_selected": { "type": "string" }
