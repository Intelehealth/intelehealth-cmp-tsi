# Copy to `.env` and replace every placeholder before starting the app.
# Generate secrets with: openssl rand -hex 32

# --- Database ---
# Local uvicorn talks to Postgres on the host. Docker Compose overrides
# POSTGRES_HOST to the `postgres_db` service automatically.
POSTGRES_HOST=postgresql://localhost:5434
POSTGRES_DB=tsi_cms
POSTGRES_USER=tsi_admin
POSTGRES_PASSWD=change-me

# --- Required secrets (min 32 characters each) ---
JWT_SECRET=
DB_ENCRYPTION_KEY=
TSI_LOOKUP_SALT=

# --- Application ---
TSI_DPDP_CMS_ENV=local
TSI_EXPORT_PATH=./exports
ALLOWED_ORIGINS=http://localhost:8091

# --- White-labeling (optional, max 12 characters) ---
# BRAND_NAME=Acme Privacy

# --- Host port mappings (docker compose) ---
PY_APP_PORT_MAP=8091:8080
PY_DB_PORT_MAP=127.0.0.1:5434:5432
