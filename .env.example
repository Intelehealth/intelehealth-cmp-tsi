# Copy to `.env` and replace every placeholder before starting the app.
# Generate secrets with: openssl rand -hex 32

# --- Database ---#
# Local uvicorn talks to Postgres on the host. Docker Compose overrides
# POSTGRES_HOST to the `postgres_db` service automatically.
POSTGRES_HOST=postgresql://localhost:5434
POSTGRES_DB=tsi_cms
POSTGRES_USER=tsi_admin
POSTGRES_PASSWD=change-me

# --- Required secrets (min 32 characters each) ---
JWT_SECRET=
DB_ENCRYPTION_KEY=
TSI_LOOKUP_SALT=
# Token the operator must present when running the initial Super-Admin setup.
# Send it as an 'X-Bootstrap-Token' header (or 'bootstrap_token' in the body).
BOOTSTRAP_TOKEN=

# --- Application ---
TSI_DPDP_CMS_ENV=local
TSI_EXPORT_PATH=./exports
ALLOWED_ORIGINS=http://localhost:8091
# Comma-separated IPs of reverse proxies in front of the API. X-Forwarded-For is
# only honoured when the immediate peer is one of these, so a direct caller
# cannot self-declare its identity and operators behind a proxy each get their
# own throttle bucket. Empty = no proxy (the socket peer is trusted).
# TRUSTED_PROXY_IPS=
# Rights-portal DUMMY_OTP mode accepts the fixed code 1234 — no real
# authentication. Allowed by default only when TSI_DPDP_CMS_ENV=local; any other
# environment must configure EMAIL_OTP / MOBILE_OTP (OTP-category webhook) or
# opt in explicitly for a demo.
# ALLOW_DUMMY_OTP=false

# --- Guardian verification (CC-05) ---
# DigiLocker partner verifier. Receives {fiduciary_id, guardian_principal_id,
# verification_ref_id} and answers {"verified": bool, "is_adult": bool}.
# Unset = DIGILOCKER guardian logs stay PENDING and cannot back a minor's consent.
# DIGILOCKER_VERIFY_URL=https://digilocker-bridge.example.com/verify

# --- Operator single sign-on, OpenID Connect (SA-06) ---
# All three set = sso_login is enabled. The IdP's amr claim decides whether the
# session counts as MFA-verified.
# SSO_ISSUER=https://login.example.com/
# SSO_AUDIENCE=tsi-dpdp-cms
# SSO_JWKS_URL=https://login.example.com/.well-known/jwks.json

# --- Purges and attachments ---
# Days an orchestrated purge may stay unconfirmed before the DPO is notified (SA-09).
# PURGE_COMPLETION_SLA_DAYS=30
# Largest grievance attachment accepted, in bytes (GR-04).
# ATTACHMENT_MAX_BYTES=5242880
# Key that signs evidence certificates (SA-14). Defaults to DB_ENCRYPTION_KEY
# when unset, so nothing extra is needed for a fresh deployment.
# CERTIFICATE_SIGNING_KEY=

# --- White-labeling (optional, max 12 characters) ---
# BRAND_NAME=Acme Privacy

# --- Host port mappings (docker compose) ---
PY_APP_PORT_MAP=8091:8080
PY_DB_PORT_MAP=127.0.0.1:5434:5432

# --- P1 background worker (worker.py) ---
# Seconds between sweep cycles, batch size per sweep. Set WORKER_POLL_SECONDS=0
# and run `python -m dpdpcms_py.worker --once` (or --poll <n>) for cron-style runs.
WORKER_POLL_SECONDS=30
WORKER_BATCH_SIZE=50

# --- P1 notification delivery adapter (delivery.py) ---
# Email channel. Omit to keep in-app delivery only (EMAIL deliveries are then
# skipped, never silently marked sent).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=notifications@example.com
# SMTP_PASSWORD=
# SMTP_FROM=notifications@example.com
# SMTP_STARTTLS=true
# SMS and push channels are simple JSON POST gateways that receive
# {"channel","recipient_id","message"} — point them at your SMS/Push provider.
# SMS_GATEWAY_URL=https://gateway.example.com/sms
# PUSH_GATEWAY_URL=https://gateway.example.com/push
NOTIFICATION_RETRY_LIMIT=5

# --- P1 webhook dispatcher (webhooks.py) ---
WEBHOOK_RETRY_LIMIT=5
# P5-07: retention floor (days) for terminal webhook_deliveries rows. The
# delivery table is the channel of record for consent events and OTP dispatch,
# so the default honours the Rule 6(1)(e) one-year floor.
# WEBHOOK_DELIVERY_RETENTION_DAYS=365

# --- P1 worker sweep thresholds ---
ALERT_ESCALATION_HOURS=24
PURGE_NOTICE_HOURS=48
GRIEVANCE_ESCALATION_HOURS=24
